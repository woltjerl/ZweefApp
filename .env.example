# GlidingApp API Configuration
GLIDING_APP_BASE_URL=https://admin.gliding.app
GLIDING_APP_VERSION=4.1.2

# Authentication Credentials (Required)
GLIDING_APP_EMAIL=your_email@example.com
GLIDING_APP_PASSWORD=your_password_here
GLIDING_APP_CLIENT_SECRET=your_client_secret_here
GLIDING_APP_ACCESS_TOKEN=your_access_token_here

# Optional: Use token-based auth (set to true) or login-based (set to false)
GLIDING_APP_USE_TOKEN_AUTH=false

# Download Configuration
OUTPUT_DIRECTORY=icg_files
RATE_LIMIT_SECONDS=4

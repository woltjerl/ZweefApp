# Upload only what the Dockerfile needs to Cloud Build: never the database, data/, .env or the
# logbook credentials in src/data_collection. Check with: gcloud meta list-files-for-upload .
*
!Dockerfile
!cloud/
!src/
src/*
!src/config.py
!src/prediction/
!src/briefing_site/
!src/airspace/
!src/weather/
src/weather/*
!src/weather/open_meteo_forecast.py
!src/visualization/
src/visualization/*
!src/visualization/basemap.py
!src/visualization/runway_constants.py
**/__pycache__/
**/.DS_Store
